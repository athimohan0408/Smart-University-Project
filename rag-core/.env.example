# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Only the key for the provider selected in config/settings.yaml (llm.provider) is needed.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama runs locally; leave blank for the default http://localhost:11434
OLLAMA_HOST=

# Once the embedding/rerank models are in the Hugging Face cache, skip the Hub check on every start
# (it turned an 11 s start into 85 s on this machine).
HF_HUB_OFFLINE=1

# Optional: load a different settings file (e.g. an eval variant)
# RAG_SETTINGS_PATH=config/settings.yaml
